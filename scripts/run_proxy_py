#!/bin/bash

set -euo pipefail

confdir=.
conffile=hlstats.conf
python_bin="${PYTHON_BIN:-python3}"
HLX_LIFECYCLE_PYTHON="${HLX_LIFECYCLE_PYTHON:-${python_bin}}"
logdir=logs
logfile="proxy_py$(date +_%Y%m%d_%H-%M-%S)"
piddir="${confdir}"
pidfile="${piddir}/proxy-daemon-py.pid"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

pythonpath="${confdir}/proxy_daemon_py"
module="proxy_daemon_py.runtime"

source "${script_dir}/lib/process_lifecycle.sh"

if [ ! -f "${confdir}/${conffile}" ]; then
  echo "Missing configuration file (${conffile})"
  exit 1
fi

if [ ! -d "${confdir}/${logdir}" ]; then
  mkdir -p "${confdir}/${logdir}"
fi

run_proxy() {
  PYTHONPATH="${pythonpath}" "${python_bin}" -m "${module}" --configfile="${conffile}" --foreground
}

start_proxy() {
  if hlx_prepare_pid_file_for_start "${pidfile}" "HLstatsX Python proxy runtime" "${module}"; then
    :
  else
    local prepare_status=$?
    [ "${prepare_status}" -eq 2 ] && return 0
    return "${prepare_status}"
  fi
  if ! hlx_identity_platform_supported; then
    echo "Refusing to start HLstatsX Python proxy runtime: Linux procfs identity checks are unavailable" >&2
    return 1
  fi
  run_proxy > "${logdir}/${logfile}" 2>&1 &
  local pid=$!
  if ! hlx_write_pid_file "${pidfile}" "${pid}" "${module}"; then
    echo "HLstatsX Python proxy runtime started but its identity could not be recorded; refusing lifecycle control" >&2
    return 1
  fi
  echo "Started HLstatsX Python proxy runtime"
}

stop_proxy() {
  hlx_stop_pid_file "${pidfile}" "HLstatsX Python proxy runtime" "${module}"
}

case "${1:-}" in
  start)
    start_proxy
    ;;
  stop)
    stop_proxy
    ;;
  restart)
    stop_proxy
    start_proxy
    ;;
  *)
    echo "Usage: ./run_proxy_py [ start | stop | restart ]"
    exit 1
    ;;
esac
