#!/bin/bash

set -euo pipefail

SCRIPTPATH=.
CONFFILE=hlstats.conf
PYTHON_BIN="${PYTHON_BIN:-python3}"
HLX_LIFECYCLE_PYTHON="${HLX_LIFECYCLE_PYTHON:-${PYTHON_BIN}}"
LOGDIR="${SCRIPTPATH}/logs"
PIDDIR="${SCRIPTPATH}"
MODULE="hlstats_py.runtime"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/lib/process_lifecycle.sh"

mkdir -p "${LOGDIR}"

start_worker() {
  local port="$1"
  local log="${LOGDIR}/hlstats_py_${port}_$(date +%Y-%m-%d_%H-%M-%S)"
  local pidfile="${PIDDIR}/hlstats_py_${port}.pid"

  if hlx_prepare_pid_file_for_start "${pidfile}" "Python stats worker on port ${port}" "${MODULE}"; then
    :
  else
    local prepare_status=$?
    [ "${prepare_status}" -eq 2 ] && return 0
    return "${prepare_status}"
  fi
  if ! hlx_identity_platform_supported; then
    echo "Refusing to start Python stats worker on port ${port}: Linux procfs identity checks are unavailable" >&2
    return 1
  fi
  "${PYTHON_BIN}" -m "${MODULE}" \
    --configfile="${CONFFILE}" \
    --port="${port}" \
    --foreground > "${log}" 2>&1 &
  local pid=$!
  if ! hlx_write_pid_file "${pidfile}" "${pid}" "${MODULE}"; then
    echo "Python stats worker on port ${port} started but its identity could not be recorded; refusing lifecycle control" >&2
    return 1
  fi
  echo "Started Python stats worker on port ${port}"
}

stop_worker() {
  local port="$1"
  local pidfile="${PIDDIR}/hlstats_py_${port}.pid"

  hlx_stop_pid_file "${pidfile}" "Python stats worker on port ${port}" "${MODULE}"
}

status_worker() {
  local port="$1"
  local pidfile="${PIDDIR}/hlstats_py_${port}.pid"
  if hlx_pid_file_status "${pidfile}" "${MODULE}"; then
    echo "Python stats worker on port ${port} is running"
  else
    local status=$?
    if [ "${status}" -eq 1 ]; then
      hlx_remove_stale_pid_file "${pidfile}" "Python stats worker on port ${port}"
      echo "Python stats worker on port ${port} is not running"
    else
      echo "Refusing status for Python stats worker on port ${port}: process ownership cannot be proven" >&2
      return 1
    fi
  fi
}

case "${1:-}" in
  start)
    NUMDAEMONS="${2:-1}"
    STARTPORT="${3:-28000}"
    INCREMENT="${4:-1}"
    i=0
    current="${STARTPORT}"
    while [ "${i}" -lt "${NUMDAEMONS}" ]; do
      start_worker "${current}"
      current=$((current + INCREMENT))
      i=$((i + 1))
    done
    ;;
  stop)
    if [ -n "${2:-}" ]; then
      stop_worker "${2}"
    else
      for pidfile in "${PIDDIR}"/hlstats_py_*.pid; do
        [ -e "${pidfile}" ] || continue
        port="$(basename "${pidfile}" .pid | sed 's/^hlstats_py_//')"
        stop_worker "${port}"
      done
    fi
    ;;
  restart)
    if [ -z "${2:-}" ]; then
      echo "Usage: ./run_hlstats_py restart <port>"
      exit 1
    fi
    stop_worker "${2}"
    start_worker "${2}"
    ;;
  status)
    if [ -n "${2:-}" ]; then
      status_worker "${2}"
    else
      for pidfile in "${PIDDIR}"/hlstats_py_*.pid; do
        [ -e "${pidfile}" ] || continue
        port="$(basename "${pidfile}" .pid | sed 's/^hlstats_py_//')"
        status_worker "${port}"
      done
    fi
    ;;
  *)
    echo "Usage: ./run_hlstats_py [ start <count> <start-port> <increment> | stop <port> | restart <port> | status <port> ]"
    exit 1
    ;;
esac
