FROM php:8.2-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libfreetype6-dev \
        libjpeg62-turbo-dev \
        libpng-dev \
        python3 \
        python3-mysqldb \
        python3-pil \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install gd mysqli pdo pdo_mysql \
    && rm -rf /var/lib/apt/lists/*

RUN { \
        echo 'upload_max_filesize=21M'; \
        echo 'post_max_size=21M'; \
        echo 'display_errors=Off'; \
        echo 'display_startup_errors=Off'; \
        echo 'log_errors=On'; \
    } > /usr/local/etc/php/conf.d/hlstats-upload-limits.ini

WORKDIR /var/www/html

COPY web /var/www/html
COPY scripts/proxy_daemon_py/fullstack/web-config.php /var/www/html/config.php
COPY scripts/hlstats_py /var/www/scripts/hlstats_py
COPY scripts/hlx_core /var/www/scripts/hlx_core
COPY scripts/run_web_updater.php /var/www/scripts/run_web_updater.php
COPY scripts/proxy_daemon_py/fullstack/hlstats.conf /var/www/scripts/hlstats.conf
COPY sql/migrations /var/www/sql/migrations
COPY heatmaps /var/www/heatmaps

RUN mkdir -p /var/www/html/hlstatsimg/progress \
    && rm -rf /var/www/heatmaps/cache \
    && mkdir -p /var/www/heatmaps/cache \
    && chown -R www-data:www-data /var/www/html /var/www/heatmaps
