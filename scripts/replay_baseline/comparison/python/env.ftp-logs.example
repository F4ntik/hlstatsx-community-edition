# Copy to env.ftp-logs (or pass via shell) and point at your host directory with *.log.
# Docker bind-mounts it into the FTP chroot — no copying thousands of files into ftp_logs/.
#
# Windows (PowerShell), from repo root:
#   $p = (Resolve-Path "scripts\replay_baseline\artifacts").Path
#   Set-Content -Path "scripts\replay_baseline\comparison\python\env.ftp-logs" -Value "HLSTATS_FTP_LOGS_HOST_PATH=$p"
#
# Then:
#   docker compose --env-file scripts/replay_baseline/comparison/python/env.ftp-logs -f scripts/replay_baseline/comparison/python/docker-compose.yml up -d log-ftp
#
# HLSTATS_FTP_LOGS_HOST_PATH=D:/PyProjects/hlstatx-ce/hlstatsx-community-edition-python-i18n/scripts/replay_baseline/artifacts
