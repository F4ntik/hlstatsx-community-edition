FROM php:8.2-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libfreetype6-dev \
        libjpeg62-turbo-dev \
        libpng-dev \
        python3 \
        python3-mysqldb \
        python3-pil \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install gd mysqli pdo pdo_mysql \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

COPY web /var/www/html
COPY scripts/replay_baseline/comparison/python/web-config.php /var/www/html/config.php
COPY scripts/hlstats_py /var/www/scripts/hlstats_py
COPY scripts/hlx_core /var/www/scripts/hlx_core
COPY scripts/replay_baseline/comparison/python/hlstats.conf /var/www/scripts/hlstats.conf
COPY heatmaps /var/www/heatmaps

RUN rm -rf /var/www/html/updater \
    && mkdir -p /var/www/html/hlstatsimg/progress \
    && rm -rf /var/www/heatmaps/cache \
    && mkdir -p /var/www/heatmaps/cache \
    && chown -R www-data:www-data /var/www/html /var/www/heatmaps
